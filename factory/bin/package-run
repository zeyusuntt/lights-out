#!/bin/sh
# Operator tool: copy a finished run's repository, add the factory, its documents and the room log, and run the offline check.
# package-run <new-dir> [--run <archived run dir>] [--room-json <file>] [--docs <dir>] [--rehearsals]
#   --run         an archive made by new-run (default: the live run in work/)
#   --room-json   the console's Download full session file; without it the room log is the CLI export,
#                 fine for a rehearsal, not for a submission, and the report says so
#   --docs        a folder with README.md, FACTORY.md and optionally evidence/; a line <!-- run-facts -->
#                 in either document is replaced by `run-stats --markdown` for this run
#   --rehearsals  add rehearsals/: the pre-kickoff results, fault matrices, reviews and the ablation triage
#   --artifact    a file the rules require at the root, copied byte for byte (repeatable), e.g. the live
#                 dossier-runway.com.json the operator saved from the highest stage
case "$1" in -h|--help) sed -n '2,/^[^#]/p' "$0" | grep "^#" | sed "s/^# \{0,1\}//"; exit 0;; esac
set -e
HOME_DIR="$(cd "$(dirname "$0")/../.." && pwd)"; dest="$1"; shift || true
run=""; roomfile=""; docs=""; rehearsals=""; artifacts=""
while [ $# -gt 0 ]; do
  case "$1" in
    --run) run="$2"; shift 2;; --room-json) roomfile="$2"; shift 2;; --docs) docs="$2"; shift 2;;
    --rehearsals) rehearsals=1; shift;; --artifact) artifacts="$artifacts
$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; shift 2;; *) echo "unknown option $1"; exit 2;;
  esac
done
[ -n "$dest" ] && [ ! -e "$dest" ] || { echo "usage: package-run <new-dir> [--run <dir>] [--room-json <file>] [--docs <dir>] [--rehearsals]"; exit 2; }
abs() { case "$1" in /*) echo "$1";; *) echo "$PWD/$1";; esac; }
dest="$(abs "$dest")"; [ -n "$run" ] && run="$(abs "$run")"; [ -n "$roomfile" ] && roomfile="$(abs "$roomfile")"; [ -n "$docs" ] && docs="$(abs "$docs")"
base="${run:-$HOME_DIR/work}"
. "$base/run.env"
git clone -q "$base/result" "$dest"
cd "$dest"; git config user.name operator; git config user.email [REDACTED]
mkdir -p mandates factory; cp "$HOME_DIR"/mandates/*.md mandates/; cp "$HOME_DIR/PROTOCOL.md" .
cp -R "$HOME_DIR/factory/bin" "$HOME_DIR/factory/lib" "$HOME_DIR/factory/hooks" "$HOME_DIR/factory/githooks" "$HOME_DIR/factory/settings" "$HOME_DIR/factory/templates" "$HOME_DIR/factory/tests" factory/
find factory -name __pycache__ -prune -exec rm -rf {} +
if [ -n "$roomfile" ]; then cp "$roomfile" room.json; echo "room.json: the given download, unchanged"
elif [ -n "$run" ]; then
  src="$run/room.json"; [ -f "$src" ] || src="$run/room-export.json"
  cp "$src" room.json; echo "room.json: $(basename "$src") from the archive; rehearsal only, a submission needs the console download"
else "$HOME_DIR/factory/bin/export-room" room.json; echo "room.json: CLI export, rehearsal only; a submission needs the console download"; fi
if [ -n "$docs" ]; then
  facts="$(mktemp)"; "$HOME_DIR/factory/bin/run-stats" ${run:+--run "$run"} --room-json "$dest/room.json" --markdown > "$facts"
  for f in README.md FACTORY.md; do
    [ -f "$docs/$f" ] || { echo "missing $docs/$f"; exit 1; }
    python3 -c 'import sys; doc, facts = (open(p).read() for p in sys.argv[1:3]); open(sys.argv[3], "w").write(doc.replace("<!-- run-facts -->", facts.strip()))' "$docs/$f" "$facts" "$f"
  done
  rm -f "$facts"
  [ -d "$docs/evidence" ] && cp -R "$docs/evidence" evidence
else
  [ -f README.md ] || printf '# %s\n\nRehearsal repository. See FACTORY.md.\n' "$RUN_ID" > README.md
  [ -f FACTORY.md ] || printf '# Factory\n\nDraft.\n' > FACTORY.md
fi
# The check reports the seats cite, and the operator's fresh-clone score, so every number has its record.
if [ -d "$base/checks" ]; then mkdir -p checks; cp -R "$base/checks/." checks/; fi
score="$(ls -t "$base"/score/summary-*.json 2>/dev/null | head -1)"
if [ -n "$score" ]; then
  id="${score##*summary-}"; id="${id%.json}"; mkdir -p checks/fresh-clone
  cp -R "$base/score/all-$id/." checks/fresh-clone/; cp "$score" checks/fresh-clone/per-folder.json
fi
mkdir -p evidence; "$HOME_DIR/factory/bin/run-stats" ${run:+--run "$run"} --room-json "$dest/room.json" > evidence/run-stats.txt
if [ -n "$rehearsals" ]; then
  mkdir -p rehearsals
  for f in RESULTS.md review-1-triage.md review-2-triage.md; do cp "$HOME_DIR/results/$f" rehearsals/; done
  cp "$HOME_DIR"/results/matrix-*.json rehearsals/
  cp "$HOME_DIR/runs/solo-pf/audit/sealed-s4/triage.md" rehearsals/solo-run-triage.md
  # The planted faults themselves, one patch each, so every matrix row can be re-run.
  for set in pf-01:faults-s4:pf01-codex pf-02:faults-s4:pf02-codex tk-01:faults-s4:tk01-codex tk-01:ampfaults-ultra-s4:tk01-amp; do
    r="${set%%:*}"; rest="${set#*:}"; d="${rest%%:*}"; name="${rest#*:}"
    [ -d "$HOME_DIR/runs/$r/audit/$d/patches" ] && mkdir -p "rehearsals/faults/$name" && cp "$HOME_DIR/runs/$r/audit/$d/patches/"* "rehearsals/faults/$name/"
  done
  printf '# Rehearsals, before kickoff\n\nEvery file here comes from rehearsal runs made before the event, not from the run in this repository. `RESULTS.md` has one row per run. `matrix-*.json` are planted-fault audits: one simulated defect per copy of an accepted service, run against each detector. `faults/` holds the planted faults, one patch each, named as in the matrices. `solo-run-triage.md` is the neutral triage of the one-agent ablation; its counts are failed test instances, and its reproductions R01 to R21 are the distinct defects.\n' > rehearsals/README.md
fi
printf '%s\n' "$artifacts" | while IFS= read -r a; do [ -z "$a" ] || cp "$a" .; done
git add -A; git commit -qm "Add factory documents, mandates and room log"
cd "${KIT_SOURCE:-$HOME_DIR/vendor/dark-factory-wearedevs}"; .venv/bin/python -m harness check "$dest" --track "$TRACK"
