#!/usr/bin/env python3
"""Publish this seat's tests into the result repository once every stage has closed, under fixed names.

    fpublish <last stage>

verifier:       checks each stage's seal, then copies sealed/stage-<n>/ to acceptance/stage-<n>/
                and the seal record to acceptance/stage-<n>/SEAL.json
second-reader:  copies probes/stage-<n>/ to acceptance/second-reader/stage-<n>/
Then commits them with fcommit and prints the commit. Run it only when the foreman says every stage has closed.
"""
import pathlib, re, shutil, subprocess, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
import fenv

args = sys.argv[1:]
if len(args) != 1 or not args[0].isdigit():
    print(__doc__); raise SystemExit(0 if args[:1] in (["-h"], ["--help"]) else 2)
last = int(args[0])
here = pathlib.Path(__file__).resolve().parent
repo = fenv.result()
skip = shutil.ignore_patterns("__pycache__", ".pytest_cache", "*.pyc", ".git", "node_modules")
if fenv.SEAT == "verifier":
    paths = []
    for n in range(1, last + 1):
        src = fenv.WORK / "verifier" / "sealed" / f"stage-{n}"
        ok = subprocess.run([str(here / "seal"), "--verify", str(n), str(src)], capture_output=True, text=True)
        if ok.returncode:
            fenv.die(f"fpublish: stage {n}'s suite no longer matches its seal: {(ok.stdout + ok.stderr).strip()[:200]}")
        dest = repo / "acceptance" / f"stage-{n}"
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(src, dest, ignore=skip)
        shutil.copy(fenv.seal_path(str(n)), dest / "SEAL.json")
        paths.append(f"acceptance/stage-{n}")
    message = f"Publish the sealed acceptance suites for stages 1 to {last}, each with its seal record"
elif fenv.SEAT == "second-reader":
    paths = []
    for n in range(1, last + 1):
        src = fenv.WORK / "second-reader" / "probes" / f"stage-{n}"
        if not src.is_dir():
            fenv.die(f"fpublish: no probes for stage {n} at {src}")
        dest = repo / "acceptance" / "second-reader" / f"stage-{n}"
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(src, dest, ignore=skip)
        paths.append(f"acceptance/second-reader/stage-{n}")
    message = f"Publish the second-reader's probes for stages 1 to {last}"
else:
    fenv.die("fpublish: only the verifier and the second-reader publish tests")
# The kit's offline check unranks an entry for any file that looks like it holds a credential, and it reads config
# files (.json and the like) strictly: a test's `token=TOKEN` placeholder is enough (sub-01, 11-13). Publish nothing
# that trips it; name what was left out, so the seat can reshape it.
flagged = []
pattern = re.compile(r"(?i)\b[A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD)\s*=\s*\S+")
config = {".env", ".yml", ".yaml", ".toml", ".cfg", ".ini", ".json"}
for top in paths:
    for f in sorted((repo / top).rglob("*")):
        if f.is_file() and f.suffix.lower() in config and pattern.search(f.read_text(errors="replace")):
            flagged.append(str(f.relative_to(repo))); f.unlink()
kit = fenv.run_env().get("KIT_SOURCE") or fenv.run_env().get("KIT")
if kit and (pathlib.Path(kit) / ".venv/bin/python").exists():
    probe = subprocess.run([str(pathlib.Path(kit) / ".venv/bin/python"), "-c",
                            "import sys, pathlib; sys.path.insert(0, sys.argv[1]); from harness import check; "
                            "print('\\n'.join(p.split(' looks like')[0] for p in check._credentials(pathlib.Path(sys.argv[2]))))",
                            kit, str(repo)], capture_output=True, text=True, cwd=kit)
    for rel in probe.stdout.split():
        if any(rel.startswith(top + "/") for top in paths) and (repo / rel).is_file():
            flagged.append(rel); (repo / rel).unlink()
if flagged:
    print("left out, because the kit's check would read them as credentials: " + ", ".join(sorted(set(flagged))))
out = subprocess.run([str(here / "fcommit"), "-m", message, *paths], capture_output=True, text=True)
if out.returncode:
    fenv.die(out.stderr.strip() or out.stdout.strip())
print(out.stdout.strip())
