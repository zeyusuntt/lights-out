#!/usr/bin/env python3
"""Open a stage to seats: post the whole task and the specification, verbatim.

    stage-open <stage> <spec-path> [--note <file>] <seat> [<seat>...]
"""
import pathlib, re, subprocess, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
import fenv

args = sys.argv[1:]
if len(args) < 3 or args[0] in ("-h", "--help"):
    print(__doc__); raise SystemExit(0)
stage, spec = args[0], pathlib.Path(args[1])
note = ""
if "--note" in args:
    i = args.index("--note"); note = pathlib.Path(args[i + 1]).read_text(); del args[i:i + 2]
seats = args[2:]
# No seat reads or receives a later stage's specification before the previous folder is final.
named = re.search(r"stage-(\d+)\.md$", spec.name)
if named and named.group(1) != stage:
    fenv.die(f"stage-open: {spec.name} is not the specification for stage {stage}")
if stage != "1":
    previous = f"accepted/stage-{int(stage) - 1}.txt"
    if subprocess.run(["git", "cat-file", "-e", f"HEAD:{previous}"], cwd=fenv.result(), capture_output=True).returncode:
        fenv.die(f"stage-open: stage {int(stage) - 1} is not accepted yet ({previous} is not committed); "
                 f"stage {stage}'s specification stays closed until it is")
task = fenv.result() / "plan" / "task.md"
parts = [f"STAGE-OPEN {stage}", f"Specification path: {spec}"]
if note:
    parts += ["", "--- FROM THE FOREMAN ---", note.strip()]
parts += ["", "--- THE TASK, VERBATIM ---", task.read_text().strip() if task.exists() else "(task not saved)",
          "", f"--- SPECIFICATION FOR STAGE {stage}, VERBATIM ---", spec.read_text().strip()]
state = fenv.WORK / "state"; state.mkdir(exist_ok=True)
(state / "current-stage").write_text(stage + "\n")
body = fenv.WORK / "tmp"; body.mkdir(exist_ok=True)
msg = body / f"stage-open-{stage}.md"
msg.write_text("\n".join(parts) + "\n")
say = pathlib.Path(__file__).with_name("fsay")
raise SystemExit(subprocess.run([str(say), *seats, "--file", str(msg)]).returncode)
