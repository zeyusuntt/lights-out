#!/usr/bin/env python3
"""Start the next stage folder as an exact copy of the accepted one, taken from its commit, not the working tree.

    stage-copy <from-stage> <to-stage> <accepted-hash>

Refuses if the new folder already holds anything. Commit the copy on its own afterwards.
"""
import io, pathlib, shutil, subprocess, sys, tarfile
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
import fenv

args = sys.argv[1:]
if len(args) != 3 or args[0] in ("-h", "--help"):
    print(__doc__); raise SystemExit(0 if args[:1] in (["-h"], ["--help"]) else 2)
src, dst, rev = args
target = fenv.result() / f"stage-{dst}"
if target.exists() and any(target.iterdir()):
    fenv.die(f"stage-copy: stage-{dst}/ already holds files")
blob = subprocess.run(["git", "archive", rev, f"stage-{src}"], cwd=fenv.result(), capture_output=True, check=True).stdout
tmp = fenv.WORK / "tmp" / f"stage-copy-{dst}"
shutil.rmtree(tmp, ignore_errors=True); tmp.mkdir(parents=True)
tarfile.open(fileobj=io.BytesIO(blob)).extractall(tmp, filter="data")
shutil.rmtree(target, ignore_errors=True)
shutil.move(str(tmp / f"stage-{src}"), str(target))
shutil.rmtree(tmp, ignore_errors=True)
print(f"stage-{dst}/ is stage-{src}/ at {rev[:12]}")
